rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }
    
    function isAdmin() {
      return hasRole('ADMIN') || isSuperAdmin();
    }
    
    function isManager() {
      return hasRole('MANAGER') || isAdmin();
    }
    
    function isFinance() {
      return hasRole('FINANCE') || isAdmin();
    }

    function isStaff() {
      return hasRole('STAFF') || isManager() || isFinance();
    }

    // --- Collections ---

    // Users Collection (Profile/Roles)
    match /users/{userId} {
      // Anyone authenticated can read basic staff directories
      allow read: if isAuthenticated();
      // Only SUPER_ADMIN can create/update roles for others
      allow write: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    // Projects Collection
    match /projects/{projectId} {
      // All staff can view projects
      allow read: if isStaff();
      // Only Managers/Admins can create/delete/modify core project details
      allow create, delete: if isManager();
      allow update: if isManager() || (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUpdated']));
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if isStaff();
      // Managers can create/delete. Staff can create (sometimes) but we restrict delete to manager.
      allow create: if isStaff();
      allow update: if isStaff(); // Staff can update task statuses
      allow delete: if isManager();
    }
    
    // Task History / Updates
    match /taskUpdates/{updateId} {
      allow read: if isStaff();
      allow create: if isStaff();
      // History should be immutable
      allow update, delete: if isSuperAdmin();
    }

    // Finance - Income/Expenses/Payments
    match /finance/{financeId} {
      // Only Finance team and Admins can view or modify financial data
      allow read, write: if isFinance();
    }

    // Courses & Batches
    match /courses/{courseId} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    
    match /batches/{batchId} {
      allow read: if isStaff();
      allow write: if isManager();
    }
    
    match /students/{studentId} {
      allow read: if isStaff();
      allow write: if isManager();
    }

    // Catch-all secure default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
